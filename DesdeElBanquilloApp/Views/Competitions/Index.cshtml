@model IEnumerable<DesdeElBanquilloApp.Models.Competition>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Name)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.CompetitionStartDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.CompetitionEndDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.idFederation)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Name)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.CompetitionStartDate)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.CompetitionEndDate)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.idFederation)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.idCompetition">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.idCompetition">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.idCompetition">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
